FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATABASE_PATH=/tmp/test-jogo.db
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py db.py jogo.py pytest.ini ./
COPY src/ ./src/
COPY tests/ ./tests/
CMD ["python", "-m", "pytest", "--junitxml=reports/backend/junit.xml", "--cov=app", "--cov=db", "--cov=jogo", "--cov=src", "--cov-report=term-missing", "--cov-report=xml:reports/backend/coverage.xml", "--cov-report=html:reports/backend/htmlcov"]
